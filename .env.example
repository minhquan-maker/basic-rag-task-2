GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Giây nghỉ giữa hai lần gọi LLM khi xây KG (tránh lỗi 429 ở gói free)
REQUEST_DELAY=4

CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=3
KG_HOPS=2
KG_MAX_TRIPLES=30
# KG-RAG có đính kèm đoạn văn gốc của các bộ ba vào prompt hay không
KG_WITH_CHUNKS=true
ENTITY_MATCH_THRESHOLD=0.75
