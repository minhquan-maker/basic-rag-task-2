GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Giây nghỉ sau mỗi lần gọi LLM lúc trích bộ ba (gói free của Gemini giới hạn số request/phút)
REQUEST_INTERVAL=4

CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=3

KG_HOPS=2
KG_MAX_FACTS=30
KG_MAX_PASSAGES=4
# Đỉnh có nhiều hơn số cạnh này sẽ không được mở rộng tiếp (tránh "đỉnh trung tâm" kéo cả đồ thị vào)
KG_HUB_LIMIT=25
# Cosine tối thiểu để khớp cụm từ trong câu hỏi với đỉnh của đồ thị bằng embedding
ENTITY_THRESHOLD=0.75
# Gộp "Hinton" vào "Geoffrey Hinton" khi không mơ hồ
ALIAS_MERGE=true
